[6.573009, "o", "\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot(x \u001b[31m->\u001b[39m sin\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx \u001b[1m\u001b[4m)\u001b[22m\u001b[24m)\u001b[1m\u001b[4m]\u001b[22m\u001b[24m\r\u001b[37C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot(x \u001b[31m->\u001b[39m sin\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx -\u001b[1m\u001b[4m)\u001b[22m\u001b[24m)\u001b[1m\u001b[4m]\u001b[22m\u001b[24m\r\u001b[38C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot(x \u001b[31m->\u001b[39m sin\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx - \u001b[1m\u001b[4m)\u001b[22m\u001b[24m)\u001b[1m\u001b[4m]\u001b[22m\u001b[24m\r\u001b[39C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot(x \u001b[31m->\u001b[39m sin\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx - t\u001b[1m\u001b[4m)\u001b[22m\u001b[24m)\u001b[1m\u001b[4m]\u001b[22m\u001b[24m\r\u001b[40C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx \u001b[31m->\u001b[39m sin(x - t)\u001b[1m\u001b[4m)]\u001b[22m\u001b[24m\r\u001b[41C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx \u001b[31m->\u001b[39m sin(x - t),\u001b[1m\u001b[4m)]\u001b[22m\u001b[24m\r\u001b[42C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u001b[22m\u001b[24mlineplot\u001b[1m\u001b[4m(\u001b[22m\u001b[24mx \u001b[31m->\u001b[39m sin(x - t), \u001b[1m\u001b[4m)]\u001b[22m\u001b[24m\r\u001b[43C\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7Cframes = \u001b[1m\u001b[4m[\u00