[4.632122, "o", "\u001b[36mInt64 <: Signed <: Integer\u001b[39m"]
[4.632232, "o", "\r\r\n\r\r\n"]
[4.632274, "o", "  "]
[4.632305, "o", "64-bit signed integer type.\r\r\n\r\r\n"]
[4.636388, "o", "  "]
[4.636444, "o", "Note that such integers overflow without warning, thus \u001b[36mtypemax(Int64) +\u001b[39m\r\r\n"]
[4.636488, "o", "  "]
[4.63651, "o", "\u001b[36mInt64(1) < 0\u001b[39m.\r\r\n"]
[4.636545, "o", "\r\r\n"]
[4.636651, "o", "  "]
