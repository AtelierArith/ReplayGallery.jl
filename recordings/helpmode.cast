[5.804664, "o", "\u001b[0m\u001b[1mℯ\u001b[22m"]
[5.804702, "o", "\r\r\n\r\r\n"]
[5.83008, "o", "\u001b[1m\u001b[0m\u001b[0m  \u001b[36mℯ\u001b[39m\r\r\n  \u001b[36me\u001b[39m\r\r\n\r\r\n  The constant ℯ.\r\r\n\r\r\n  Unicode \u001b[36mℯ\u001b[39m can be typed by writing \u001b[36m\\euler\u001b[39m and pressing tab in the Julia REPL,\r\r\n  and in many editors.\r\r\n\r\r\n  See also: \u001b[36m\u001b[4mexp\u001b[39m\u001b[24m, \u001b[36m\u001b[4mcis\u001b[39m\u001b[24m, \u001b[36m\u001b[4mcispi\u001b[39m\u001b[24m.\r\r\n\r\r\n\u001b[1m  Examples\u001b[22m\r\r\n  \u001b[1m≡≡≡≡≡≡≡≡\u001b[22m\r\r\n\r\r\n  \u001b[32m\u001b[1mjulia>\u001b[36m\u001b[22m ℯ\u001b[39m\r\r\n  \u001b[36mℯ = 2.7182818284590...\u001b[39m\r\r\n  \r\r\n  \u001b[32m\u001b[1mjulia>\u001b[36m\u001b[22m log(ℯ)\u001b[39m\r\r\n  \u001b[36m1\u001b[39m\r\r\n  \r\r\n  \u001b[32m\u001b[1mjulia>\u001b[36m\u001b[22m ℯ^(im)π ≈ -1\u001b[39m\r\r\n  \u001b[36mtrue\u001b[39m\r\r\n\r\r\n\r\u001b[0K\r\u001b[0K\u001b[32m\u001b[1mjulia> \u001b[0m\u001b[0m\r\u001b[7C\r\u001b[7C"]
